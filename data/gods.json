      "intervene": {
        "devotion": [
          "여기를 막으세요.",
          "이 정도는 미리 세워 뒀어요.",
          "판이 보이나요?"
        ],
        "calm": [
          "부족하지만 드릴게요.",
          "여기까지예요.",
          "한 겹 더요."
