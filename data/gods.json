        "wrath": [
          "막을 것은 직접 세우세요.",
          "빌린 방벽은 돌려받아요.",
          "무너지세요."
        ]
      },
      "cross": {
        "devotion": [
          "이제 제 이름으로 싸우세요."
        ],
        "calm": [
          "좋아요. 여기서부터 볼게요."
        ],
        "anger": [
          "제가 화났다는 것만 알아 두세요."
        ],
        "wrath": [
          "끝났어요. 이제 제 계산에 당신은 없어요."
        ]
      },
      "demand_offer": [
        "조건이 있어요. 읽고 답하세요."
      ],
      "demand_kept": [
        "좋아요. 다음은 더 잘하세요."
      ],
      "demand_broken": [
        "예상한 결과예요."
      ],
      "tear": [
