    "lines": {
      "encounter": {
        "devotion": [
          "하하! 가게. 하늘은 열어 뒀네.",
          "자네 앞은 내가 치지."
        ],
        "calm": [
          "시작하게. 보고 있음세.",
          "어디 한번 놀아 보게."
        ],
        "anger": [
          "지금은 구경만 하겠네.",
          "자네 이름이 뭐였더라?"
        ],
        "wrath": [
          "하늘은 닫았네.",
          "무릎을 꿇든지, 타든지 하게."
        ]
      },
      "intervene": {
        "devotion": [
          "받게!",
          "내려치네!",
          "길은 텄네."
        ],
        "calm": [
          "옜네.",
          "한 번 더 가지.",
          "그쯤이야."
        ],
        "anger": [
          "이건 은혜가 아닐세.",
          "값은 세고 있네.",
          "아직은 참지."
        ],
        "wrath": [
          "준 것은 거두겠네.",
          "그 번개, 빌린 것이었네.",
          "타게."
        ]
      },
      "cross": {
        "devotion": [
          "이제 내 이름으로 치게!"
        ],
        "calm": [
          "됐네. 여기서부터 봄세."
        ],
        "anger": [
          "내가 화났다는 것만 알아 두게."
        ],
        "wrath": [
          "끝났네. 하늘이 자네를 치네."
        ]
      },
      "demand_offer": [
        "들어 보게. 두 번은 말 안 하네."
      ],
      "demand_kept": [
        "하하! 그래야지."
      ],
      "demand_broken": [
        "말을 흘려들었구먼."
      ],
      "tear": [
        "그 번개는 내 것일세.",
        "자네 손에 남은 건 재뿐이네."
      ],
      "join": [
        "자네가 버린 것이 여기 서 있네."
      ],
      "reconcile": [
        "됐네! 그 정도면 들어줄 만하지."
      ]
    }
  },
