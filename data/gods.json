    "lines": {
      "encounter": {
        "devotion": [
          "어디부터 무너뜨려 줄까?",
          "물은 벌써 자네 편일세."
        ],
        "calm": [
          "급할 것 있나?",
          "숨부터 고르게."
        ],
        "anger": [
          "또 넷을 한꺼번에 칠 셈인가?",
          "뭐가 그리 급한가."
        ],
        "wrath": [
          "이제 와서 바다를 부르나?",
          "물이 자네 발밑인 걸 잊었나."
        ]
      },
      "intervene": {
        "devotion": [
          "하나면 되네.",
          "깊은 데를 치게.",
          "밀어 줌세."
        ],
        "calm": [
          "천천히 가게.",
          "이만큼은 주지.",
          "물이 스미는군."
        ],
        "anger": [
          "그게 최선인가?",
          "손이 몇 개라고 생각하나.",
          "덜어 준 적은 없네."
        ],
        "wrath": [
          "물이 자네 쪽으로는 안 가네.",
          "누굴 부른 건가?",
          "가라앉게."
        ]
      },
      "cross": {
        "devotion": [
          "이제 물길은 자네 것일세. 마음껏 쓰게."
        ],
        "calm": [
          "됐네. 어디까지 가나 봄세."
        ],
        "anger": [
          "바다가 등을 돌리는 중이네. 알고는 있게."
        ],
        "wrath": [
          "끝일세. 바다가 자네를 삼키네."
        ]
      },
      "demand_offer": [
        "하나만 묻지. 할 수 있겠나?"
      ],
      "demand_kept": [
        "할 수 있었구먼."
      ],
      "demand_broken": [
        "역시 급했어."
      ],
      "tear": [
        "그걸 부술 셈인가?",
        "자네 손으로 갈랐네. 기억해 두게."
      ],
      "join": [
        "내가 왜 저쪽에 서 있는지 알겠나?"
      ],
      "reconcile": [
        "이제야 숨을 고르는군."
      ]
