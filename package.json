{
  "name": "god-scales",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "art": "node --experimental-strip-types tools/art.ts",
    "sim": "node --experimental-strip-types sim/runner.ts",
    "play": "node --experimental-strip-types sim/play.ts",
    "report": "node --experimental-strip-types sim/heatmap.ts",
    "size": "node --experimental-strip-types tools/size.ts",
